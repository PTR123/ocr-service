# OCR 微服务配置（FastAPI + RapidOCR）
#
# 复制为 .env 并修改：
#   cp .env.example .env

# 服务端口
OCR_SERVICE_PORT=8000

# 业务 API Key（用于调用方鉴权；现在存于 DB，此环境变量不再用于业务鉴权）
# 保留用于兼容，实际业务 key 由 dashboard 创建

# 管理员 Key（访问 /dashboard 与 /admin/* 管理接口）
# 生成：openssl rand -hex 32
OCR_ADMIN_KEY=change-me-admin-key

# SQLite 数据库文件路径
OCR_DB_PATH=ocr.db

# RapidOCR 参数
# 单张图片最大尺寸（像素边长上限，超限先缩放，防止超大图拖慢推理）
OCR_MAX_SIDE=2048

